# Supabase — Project Settings > API
# Nunca commite o .env.local (já está no .gitignore). Este ficheiro é apenas o modelo.

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
# Secreta — só usada em código server-side (nunca exposta ao browser)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Código de acesso exigido por /onboarding para criar uma clínica nova.
# Sem esta variável o onboarding fica desligado.
ONBOARDING_SECRET=
